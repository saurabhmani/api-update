# ════════════════════════════════════════════════════════════════
#  Quantorus365 — Environment Template (Phase 0)
#
#  Copy to `.env.local` (development) or `.env` (production) and
#  fill every REQUIRED value. Never commit real secrets.
#
#  Rotation guide: docs/security/credential-rotation.md
# ════════════════════════════════════════════════════════════════

# ── Database (MySQL) ────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=quantorus365
MYSQL_PORT=3306

# ── PostgreSQL (optional — dual-write / migration) ──────────────
# PG_HOST=localhost
# PG_USER=your_pg_user
# PG_PASSWORD=your_pg_password
# PG_DATABASE=quantorus365
# PG_PORT=5432

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Quantorus365
NODE_ENV=development

# ── Session & encryption (REQUIRED — generate fresh values) ─────
# openssl rand -hex 32
SESSION_SECRET=generate_64_char_hex_secret
SESSION_MAX_AGE=86400
ENCRYPTION_KEY=generate_64_char_hex_aes_key

# ── WebSocket stream server ─────────────────────────────────────
STREAM_WS_PORT=3001
NEXT_PUBLIC_STREAM_WS_PORT=3001
NEXT_PUBLIC_STREAM_WS_DISABLED=false

# ── Redis (optional) ────────────────────────────────────────────
REDIS_DISABLED=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your_redis_password

# ── Market data providers ───────────────────────────────────────
# Default primary is Kite when MARKET_DATA_PROVIDER is unset.
# Fallback cascade: kite → yahoo → nse → db.
MARKET_DATA_PROVIDER=kite

# ── Kite / Zerodha Connect (default primary) ────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=your_kite_access_token
# Production must match the Redirect URL in the Zerodha Kite Connect app:
#   https://quantorus.in/api/kite/auth/callback
# Do NOT use localhost:5000 — that is the internal Node bind address only.
# KITE_REDIRECT_URL=https://quantorus.in/api/kite/auth/callback
# Optional explicit public origin for post-login browser redirects:
# APP_URL=https://quantorus.in
# APP_BASE_URL=https://quantorus.in
KITE_ENABLED=true

# ── Shoonya OAuth (data-source login) ───────────────────────────
# Set SHOONYA_ENABLED=true (or provide CLIENT_ID) to require credentials at boot.
# SHOONYA_ENABLED=false
# SHOONYA_CLIENT_ID=your_shoonya_client_id
# SHOONYA_SECRET_CODE=your_shoonya_secret_code
# Optional uid required by live GenAcsTok for some Finvasia accounts:
# SHOONYA_UID=your_shoonya_user_id
# SHOONYA_REDIRECT_URL=https://quantorus.in/api/brokers/shoonya/callback
# Optional overrides (defaults shown):
# SHOONYA_AUTHORIZE_URL=https://trade.shoonya.com/OAuthlogin/authorize/oauth
# SHOONYA_TOKEN_URL=https://api.shoonya.com/NorenWClientAPI/GenAcsTok

# Required in production (64 hex chars). Dev may fall back to ENCRYPTION_KEY.
# BROKER_TOKEN_ENCRYPTION_KEY=generate_64_char_hex_aes_key
# BROKER_TOKEN_ALLOW_LEGACY_KEY=0

# Absolute public origin used for OAuth redirects (https in production):
# APP_BASE_URL=https://quantorus.in

# ── Other provider gates ────────────────────────────────────────
YAHOO_EMERGENCY_FALLBACK_ENABLED=true
NSE_DIRECT_FALLBACK_ENABLED=true

# ── Signal engine ───────────────────────────────────────────────
DEBUG_FORCE_SIGNAL=false
Q365_INPROC_REGEN=0
Q365_INPROC_SCHEDULER=0
SIGNAL_ENGINE_STALE_CANDLE_MAX_DAYS=7
UNIVERSE_MODE=NIFTY500
CUSTOM_UNIVERSE_PATH=ind_nifty500list.csv
MIN_DAILY_CANDLES=80

# ── Learning scheduler ──────────────────────────────────────────
# Run via: npm run learning-scheduler

# ── News intelligence (optional paid feeds) ─────────────────────
# GNEWS_API_KEY=
# NEWSDATA_API_KEY=
# NEWSAPI_API_KEY=
# FINNHUB_API_KEY=

# ── Email / OTP (production) ────────────────────────────────────
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Quantorus365 <noreply@yourdomain.com>

# ── Development seed users (NEVER set in production) ────────────
# SEED_ADMIN_PASSWORD=
# SEED_JOHN_PASSWORD=
# SEED_PRIYA_PASSWORD=
