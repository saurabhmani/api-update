# Market data — IndianAPI only (no Kite / Zerodha / Shoonya upstream)
INDIANAPI_ENABLED=true
INDIANAPI_API_KEY=
INDIAN_API_REQUESTS_PER_SECOND=10
MARKET_DATA_PROVIDER=indianapi
SIGNALS_DATABASE_BOOTSTRAP_ENABLED=true

# Paper-trading account encryption (not broker OAuth)
ENCRYPTION_KEY=

