# ════════════════════════════════════════════════════════════════
#  Quantorus365 — Environment Template
#
#  Copy to `.env.local` (development) or `.env` (production) and
#  fill every REQUIRED value. Never commit real secrets.
#
#  Rotation guide: docs/security/secrets-rotation.md
# ════════════════════════════════════════════════════════════════

# ── Database (MySQL) ────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=quantorus365
MYSQL_PORT=3306

# ── PostgreSQL (optional — dual-write / migration) ──────────────
# PG_HOST=localhost
# PG_USER=your_pg_user
# PG_PASSWORD=your_pg_password
# PG_DATABASE=quantorus365
# PG_PORT=5432

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Quantorus365
NODE_ENV=development

# ── Session & encryption (REQUIRED — generate fresh values) ─────
SESSION_SECRET=generate_64_char_hex_secret
SESSION_MAX_AGE=86400
ENCRYPTION_KEY=generate_64_char_hex_aes_key

# ── WebSocket stream server ─────────────────────────────────────
STREAM_WS_PORT=3001
NEXT_PUBLIC_STREAM_WS_PORT=3001
NEXT_PUBLIC_STREAM_WS_DISABLED=false

# ── Redis (optional) ────────────────────────────────────────────
REDIS_DISABLED=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your_redis_password

# ── Market data providers (Phase 9) ─────────────────────────────
# Default primary is Kite when MARKET_DATA_PROVIDER is unset in code.
# IndianAPI remains installed for automatic fallback + unsupported
# capabilities (movers, trending, news, corporate, mutual funds, forecasts).
#
# Pin explicitly for production:
MARKET_DATA_PROVIDER=kite
#
# Immediate recovery to IndianAPI (wins over MARKET_DATA_PROVIDER):
INDIANAPI_PRIMARY=false
# INDIANAPI_PRIMARY=true
#
# Existing installs that keep MARKET_DATA_PROVIDER=indianapi are unchanged.

# ── Kite / Zerodha Connect (default primary) ────────────────────
# Required when MARKET_DATA_PROVIDER=kite (or relying on the code default).
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=your_kite_access_token
# KITE_REDIRECT_URL=http://localhost:3000/api/kite/callback
KITE_ENABLED=true

# ── IndianAPI (fallback + unsupported features — keep configured) ─
INDIANAPI_API_KEY=your_indianapi_key
INDIANAPI_BASE_URL=https://stock.indianapi.in
INDIANAPI_ENABLED=true
INDIANAPI_BLOCK_OUTSIDE_MARKET=1
INDIANAPI_TIMEOUT_MS=10000
INDIANAPI_RETRY_ATTEMPTS=3
INDIANAPI_MONTHLY_LIMIT=100000
INDIANAPI_DAILY_SOFT_LIMIT=4500

# ── Other provider gates ────────────────────────────────────────
YAHOO_EMERGENCY_FALLBACK_ENABLED=false
NSE_DIRECT_FALLBACK_ENABLED=true

# ── Signal engine ───────────────────────────────────────────────
DEBUG_FORCE_SIGNAL=false
Q365_INPROC_REGEN=0
Q365_INPROC_SCHEDULER=0
SIGNAL_ENGINE_STALE_CANDLE_MAX_DAYS=7
UNIVERSE_MODE=NIFTY500
CUSTOM_UNIVERSE_PATH=ind_nifty500list.csv
MIN_DAILY_CANDLES=80

# ── Learning scheduler ──────────────────────────────────────────
# Run via: npm run learning-scheduler

# ── News intelligence (optional paid feeds) ─────────────────────
# GNEWS_API_KEY=
# NEWSDATA_API_KEY=
# NEWSAPI_API_KEY=
# FINNHUB_API_KEY=

# ── Email / OTP (production) ────────────────────────────────────
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Quantorus365 <noreply@yourdomain.com>

# ── Development seed users (NEVER set in production) ────────────
# SEED_ADMIN_PASSWORD=
# SEED_JOHN_PASSWORD=
# SEED_PRIYA_PASSWORD=
