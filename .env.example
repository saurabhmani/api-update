# ══════════════════════════════════════════════════════════════════
#  Quantorus365 — environment template
#
#  Copy to `.env.local` (dev) or `.env` (prod via server.js) and fill
#  in real values. NEVER commit real secrets. Variables marked
#  [REQUIRED] block boot or a core feature when missing.
#
#  Production safety: envSafetyLock refuses to boot production if
#  FORCE_MARKET_OPEN / MOCK_MARKET_OPEN / BYPASS_MARKET_HOURS are
#  truthy, CANDLE_MAX_PER_CYCLE > 100, or INDIANAPI_PER_RUN_LIMIT > 500.
# ══════════════════════════════════════════════════════════════════

# ── Core app ────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Quantorus365
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [REQUIRED] >= 32 chars; session cookie signing
SESSION_SECRET=change-me-to-a-long-random-string-32ch
SESSION_MAX_AGE=86400
# 64-char hex for TOTP secrets; falls back to SHA-256(SESSION_SECRET)
ENCRYPTION_KEY=

# ── Database (MySQL — current production target) ───────────────────
# [REQUIRED]
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=quantorus
MYSQL_PASSWORD=
MYSQL_DATABASE=quantorus365

# ── Redis (optional; set REDIS_DISABLED=true to skip) ──────────────
REDIS_DISABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# ── Market data providers ───────────────────────────────────────────
# [REQUIRED for live data] IndianAPI key + endpoints
INDIANAPI_API_KEY=
INDIANAPI_BASE_URL=https://stock.indianapi.in
INDIANAPI_ENABLED=true
INDIANAPI_PRIMARY=true
MARKET_DATA_PROVIDER=indianapi
MARKET_DATA_PRIMARY_PROVIDER=indianapi
MARKET_DATA_FALLBACK_PROVIDER=yahoo
# Quota guards — keep PER_RUN <= 500 in prod (envSafetyLock)
INDIANAPI_PER_RUN_LIMIT=100
INDIANAPI_DAILY_SOFT_LIMIT=2500
INDIANAPI_MONTHLY_LIMIT=70000
INDIANAPI_MIN_CALL_GAP_MS=250
INDIANAPI_TIMEOUT_MS=10000
INDIANAPI_RETRY_ATTEMPTS=2
INDIANAPI_BLOCK_OUTSIDE_MARKET=true
INDIANAPI_BUDGET_REDUCE_THRESHOLD=0.6
INDIANAPI_BUDGET_CRITICAL_THRESHOLD=0.9
ENABLE_PROVIDER_REQUEST_LOGGING=true
# Emergency Yahoo fallback (single-source mode only)
YAHOO_EMERGENCY_FALLBACK_ENABLED=true
YAHOO_LIVE_CONCURRENCY=4
YAHOO_LIVE_GAP_MS=350
USE_YAHOO_ONLY=false
# NSE direct fallback ladder
ENABLE_NSE_FALLBACK=false
NSE_DIRECT_FALLBACK_ENABLED=false
NSE_DIRECT_FALLBACK_MAX_SYMBOLS_PER_DAY=50
NSE_DIRECT_FALLBACK_MIN_DELAY_MS=1500
NSE_DIRECT_FALLBACK_REQUEST_TIMEOUT_MS=8000
NSE_DIRECT_FALLBACK_TRIGGER_FAILURES=3

# ── Live feed (signals-critical) ────────────────────────────────────
# Provider for the live WS poll loop: indianapi | yahoo | dual
LIVE_FEED_PROVIDER=indianapi
MARKET_FEED_POLL_MS=5000
# Freshness bands — quality drops to delayed/stale past these ages.
# stale during market hours BLOCKS new approvals.
LIVE_FEED_DELAYED_MS=45000
LIVE_FEED_STALE_MS=120000
LIVE_FEED_BASELINE_SYMBOLS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK
LIVE_SIGNAL_RECALC_DEBOUNCE_MS=3000
# WebSocket stream server — MUST stay enabled in prod market hours
NEXT_PUBLIC_STREAM_WS_DISABLED=false
NEXT_PUBLIC_STREAM_WS_PORT=5001
STREAM_WS_PORT=5001

# ── Dual-source validation (signals-critical) ───────────────────────
DUAL_SOURCE_ENABLED=true
DUAL_SOURCE_PRICE_TOLERANCE_BPS=50
DUAL_SOURCE_VOLUME_TOLERANCE_PCT=25
DUAL_SOURCE_TIMESTAMP_TOLERANCE_MS=120000
DUAL_SOURCE_MIN_CONFIDENCE=80
DUAL_SOURCE_ALLOW_SINGLE_SOURCE=false
DUAL_SOURCE_AUTHORITATIVE=indianapi
DUAL_SOURCE_OUTLIER_SPIKE_BPS=500

# ── Signal engine (signals-critical) ────────────────────────────────
# Per-run universe cap — chunk rotation walks the full universe.
SIGNAL_RUN_UNIVERSE_CAP=100
SIGNAL_INTRADAY_REGEN_ENABLED=true
SIGNALS_AUTO_RECOVERY_ENABLED=true
SIGNALS_AUTO_RECOVERY_ALLOW_ON_READ=false
SIGNALS_LIVE_MARKET_TTL_MS=60000
Q365_INPROC_SCHEDULER=true
Q365_INPROC_REGEN=true
Q365_REGEN_24X7=false
# Strict tier floors (env-tunable; defaults in confirmedSignalPolicy.ts)
SIGNAL_API_STRICT_CONFIDENCE_FLOOR=55
SIGNAL_API_STRICT_FINAL_FLOOR=60
SIGNAL_API_STRICT_RR_FLOOR=1.5
# Relaxed tier fallback
SIGNAL_API_ENABLE_RELAXED=true
SIGNAL_API_RELAX_CONFIDENCE_FLOOR=50
SIGNAL_API_RELAX_FINAL_FLOOR=55
SIGNAL_API_RELAX_RR_FLOOR=1.2
SIGNAL_RELAX_MODE=false
# Elite gate: 0 disables; NEVER_EMPTY=1 restores is_relaxed fallback
ELITE_GATE=1
SIGNAL_ELITE_NEVER_EMPTY=false
SIGNAL_ELITE_LENIENT_FACTORS=false
SIGNAL_BEST_AVAILABLE_FALLBACK=false
SIGNAL_STICKY_VISIBILITY_MIN=30
SIGNAL_ENGINE_ALLOW_HIGH_VOL=false
SIGNAL_ENGINE_STALE_CANDLE_SOFT_HOURS=30
SIGNAL_ENGINE_STALE_CANDLE_MAX_DAYS=5
# NEVER set truthy in production (envSafetyLock blocks boot)
FORCE_MARKET_OPEN=
DEBUG_FORCE_SIGNAL=

# ── Maturity / confirmed snapshots ──────────────────────────────────
MATURITY_MIN_CYCLES=3
MATURITY_MIN_AGE_MINUTES=30
MATURITY_PROMOTE_THRESHOLD=85
MATURITY_MATURE_THRESHOLD=85
MATURITY_STABILITY_RAW_FLOOR=60
PROMOTE_MIN_CYCLES=3
PROMOTE_MIN_MATURITY=85
CONFIRMED_SNAPSHOT_VALIDITY_MINUTES=240
TRACKER_STALE_HOURS=30
TRACKER_STALE_RESET_MIN=60
TRACKER_FALLBACK_FRESHNESS_HOURS=30
MIN_COVERAGE_FOR_CONFIRMED=80

# ── Pipeline locks / watchdogs ──────────────────────────────────────
PIPELINE_STALE_INFLIGHT_MS=30000
PIPELINE_NO_PROGRESS_MS=30000
PIPELINE_MANUAL_OVERRIDE=false

# ── Universe ────────────────────────────────────────────────────────
UNIVERSE_MODE=nse1000
UNIVERSE_TARGET_SIZE=1000
UNIVERSE_MIN_SIZE=400
UNIVERSE_WEEKLY_REBUILD_ENABLED=true
UNIVERSE_WEEKLY_REBUILD_CRON=30 2 * * 0
UNIVERSE_CHURN_KEEP_MAX_RANK=1100
UNIVERSE_CHURN_ADD_MAX_RANK=1000
UNIVERSE_CHURN_REMOVE_MIN_RANK=1250
UNIVERSE_REBUILD_BACKFILL_LIMIT=250
CUSTOM_UNIVERSE_PATH=
SECURITIES_MASTER_CSV_PATH=

# ── Candles / warehouse ─────────────────────────────────────────────
# Keep <= 100 in prod (envSafetyLock)
CANDLE_MAX_PER_CYCLE=50
CANDLE_REFRESH_INTERVAL_MS=60000
CANDLE_INGEST_CONCURRENCY=4
CANDLE_INGEST_MAX_AGE_HOURS=26
CANDLE_BACKFILL_UNIVERSE_LIMIT=2500
MIN_DAILY_CANDLES=60
TARGET_BACKFILL_DAILY_CANDLES=250
PREOPEN_CANDLE_WARMUP_ENABLED=true
DAILY_SCAN_UNIVERSE_LIMIT=1000
DATA_FRESHNESS_SLA_MS=900000

# ── Cache TTLs ──────────────────────────────────────────────────────
CACHE_TTL_LIVE_PRICE_MS=5000
CACHE_TTL_INTRADAY_MS=60000
CACHE_TTL_OVERVIEW_MS=300000
CACHE_TTL_NEWS_MS=600000
CACHE_TTL_CORPORATE_MS=3600000

# ── Budget guards ───────────────────────────────────────────────────
BUDGET_DAILY_SOFT_CAP=2000
BUDGET_MONTHLY_SOFT_TARGET=44000
BUDGET_MONTHLY_SOFT_CAP=60000
BUDGET_MONTHLY_HARD_LIMIT=70000
BUDGET_MONTHLY_FREEZE=false
FEED_HEALTH_RETENTION_DAYS=30

# ── Production alerts (signals observability) ──────────────────────
# 5-min monitor evaluates: no confirmed signals (market hours), live
# feed stale, scanner stuck in-flight, IndianAPI quota >90%.
ALERT_MONITOR_DISABLED=false
ALERT_NO_CONFIRMED_SIGNALS_MIN=30
ALERT_STUCK_INFLIGHT_MIN=5
ALERT_QUOTA_WARNING_PCT=90
# Delivery channels — leave empty to keep alerts in-dashboard only
SLACK_OPS_WEBHOOK_URL=
OPS_EMAIL_TO=
OPS_EMAIL_FROM=
RESEND_API_KEY=
RELIABILITY_SYSTEM_ALERTS=true

# ── News / RSS ──────────────────────────────────────────────────────
NSE_ANNOUNCEMENTS_RSS=https://nsearchives.nseindia.com/content/RSS/Online_announcements.xml
BSE_ANNOUNCEMENTS_RSS=https://www.bseindia.com/data/xml/notices.xml

# ── Brokers (signal-only mode; leave disabled unless integrating) ──
KITE_ENABLED=false
DISABLE_KITE=true

# ── Dev seed users (dev only — remove in prod) ─────────────────────
SEED_ADMIN_PASSWORD=
SEED_JOHN_PASSWORD=
SEED_PRIYA_PASSWORD=
